# Copy to backend/.env; loaded automatically when starting Go from backend/.
# Existing process environment variables take precedence.
OPENAI_API_KEY='your-api-key'
OPENAI_VISION_MODEL=gpt-4.1-mini

# Set true when serving the app over HTTPS, including behind a reverse proxy.
# Leave false only for local HTTP development.
AUTH_COOKIE_SECURE=false

# Optional: identify your app/contact when using the public barcode catalogue.
OPENFOODFACTS_USER_AGENT=WineVault/0.1 (personal wine cellar organizer)
DATABASE_URL=postgres://winevault:winevault_dev@127.0.0.1:5432/winevault?sslmode=disable
# Optional Docker Compose overrides. Defaults work without an .env file.

POSTGRES_DB=winevault
POSTGRES_USER=winevault
POSTGRES_PASSWORD=winevault_dev
POSTGRES_PORT=5432
